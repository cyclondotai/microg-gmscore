<resources>
    <bool name="migration_results_light_bars">true</bool>

    <!-- Transferred apps (CYC-3525): the warm-paper / black ground from the first frame, no framework action bar. -->
    <style name="Theme.Cyclon.MigrationResults" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/migration_results_ground</item>
        <item name="android:colorBackground">@color/migration_results_ground</item>
        <item name="android:windowSplashScreenBackground">@color/migration_results_ground</item>
        <item name="android:statusBarColor">@color/migration_results_ground</item>
        <item name="android:navigationBarColor">@color/migration_results_ground</item>
        <item name="android:windowLightStatusBar">@bool/migration_results_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/migration_results_light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>
</resources>
